{
  "name": "mrjim-auth",
  "version": "0.1.0",
  "description": "Project-owned Node.js, PostgreSQL, and S3 authentication and storage with a Supabase-shaped client API",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./postgres": {
      "types": "./dist/postgres/index.d.ts",
      "import": "./dist/postgres/index.js"
    },
    "./express": {
      "types": "./dist/adapters/express.d.ts",
      "import": "./dist/adapters/express.js"
    },
    "./nextjs": {
      "types": "./dist/adapters/nextjs-browser.d.ts",
      "import": "./dist/adapters/nextjs-browser.js"
    },
    "./nextjs/server": {
      "types": "./dist/adapters/nextjs-server.d.ts",
      "import": "./dist/adapters/nextjs-server.js"
    },
    "./client/pkce": {
      "types": "./dist/client/pkce.d.ts",
      "import": "./dist/client/pkce.js"
    },
    "./storage": {
      "types": "./dist/storage/index.d.ts",
      "import": "./dist/storage/index.js"
    },
    "./storage/s3": {
      "types": "./dist/storage/s3.d.ts",
      "import": "./dist/storage/s3.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "bin": {
    "mrjim-auth": "./dist/cli/index.js"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@aws-sdk/client-s3": "3.1109.0",
    "@aws-sdk/s3-request-presigner": "3.1109.0",
    "argon2": "0.44.0",
    "jose": "6.2.8",
    "kysely": "0.29.5",
    "openid-client": "6.8.4",
    "pg": "8.23.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/pg": "8.21.0"
  }
}
