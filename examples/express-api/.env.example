DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/mrjim_auth_example
AUTH_ENVIRONMENT=development
AUTH_BASE_URL=http://localhost:3000/auth/v1
AUTH_SITE_URL=http://localhost:5173
AUTH_ALLOWED_REDIRECTS=http://localhost:5173/auth/callback,http://localhost:5173/auth/recovery
AUTH_TOKEN_AUDIENCE=express-api
AUTH_ES256_KEY_ID=local-primary
AUTH_ES256_PRIVATE_JWK={"kty":"EC","crv":"P-256","x":"replace","y":"replace","d":"replace"}
AUTH_TOKEN_HASH_KEY=replace_with_unpadded_base64url_for_exactly_32_random_bytes
AUTH_ENCRYPTION_KEY=replace_with_unpadded_base64url_for_at_least_32_random_bytes
AUTH_RATE_LIMIT_HASH_KEY=replace_with_unpadded_base64url_for_exactly_32_random_bytes
PORT=3000
